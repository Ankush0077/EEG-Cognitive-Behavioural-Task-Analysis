      <CodeComponent name="code_thx" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="&amp;#10;//Change the text according to the selected language, function SetTxtThx()&amp;#10;function SetTxtThx(){&amp;#10;    if (english){&amp;#10;        thx.text = &quot;Thank you for your participation!&quot;;&amp;#10;    }&amp;#10;    else{&amp;#10;        thx.text = &quot;Merci de votre participation!&quot;;&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;// Compute additional scores, save them to the data file and send them to Redcap&amp;#10;function GetData(){&amp;#10;    try{&amp;#10;        let data = thisExp._trialsData;&amp;#10;        &amp;#10;        /* Make array objects all have the same keys */&amp;#10;        let defaults = { &quot;Language&quot; : &quot;&quot;, &quot;participant&quot; : &quot;&quot;, &quot;date&quot; : &quot;&quot;, &quot;session&quot;: &quot;&quot;, &quot;expName:&quot;:&quot;&quot;, &quot;psychopyVersion&quot;: &quot;&quot;, &quot;OS&quot;: &quot;&quot;, &quot;frameRate&quot;: &quot;&quot;, &quot;mouse_instr.x&quot; : &quot;&quot;, &amp;#10;        &quot;mouse_instr.y&quot; : &quot;&quot;, &quot;mouse_instr.leftButton&quot; : &quot;&quot;, &quot;mouse_instr.midButton&quot; : &quot;&quot;, &quot;mouse_instr.rightButton&quot; : &quot;&quot;, &quot;mouse_instr.time&quot;: &quot;&quot;, &amp;#10;        &quot;mouse_instr.clicked_name&quot;: &quot;&quot;, &quot;currentTrial&quot;: &quot;&quot;, &quot;Target_Distractor&quot; : &quot;&quot;, &quot;Decision_jar&quot; : &quot;&quot;, &quot;DTD&quot; : &quot;&quot;, &quot;Match&quot; : &quot;&quot;, &quot;rating.rt&quot;: &quot;&quot;, &quot;rating.response&quot;: &quot;&quot;, &quot;rating.history&quot;: &quot;&quot;};&amp;#10;        data = $.map( data, function( item ){&amp;#10;            return $.extend( {}, defaults, item ); &amp;#10;        });&amp;#10;        &amp;#10;        // Rename &quot;index&quot; key to avoid errors&amp;#10;        data = data.map(elem =&gt; {&amp;#10;            elem.given_index = elem.index;&amp;#10;            delete elem.index;&amp;#10;            return elem;&amp;#10;        });&amp;#10;        &amp;#10;        // Create all the variables we will need&amp;#10;        let data2 = [&quot;beads_orig_dtd&quot;, &quot;beads_orig_match&quot;, &quot;beads_orig_trial_duration&quot;, &amp;#10;        &quot;beads_orig_confidence_rating&quot;, &quot;beads_targ_dtd&quot;, &quot;beads_targ_match&quot;,&quot;beads_targ_confidence_rating&quot;];&amp;#10;        &amp;#10;        for (let i = 0; i &lt; data2.length; i++) {&amp;#10;            data[data2[i]] = &quot;&quot;;&amp;#10;        }&amp;#10;        &amp;#10;        // Create our dataframe where we will compute all the values&amp;#10;        &amp;#10;        let df1 = new dfd.DataFrame(data);&amp;#10;        &amp;#10;        let df1_orig = df1.loc({&amp;#10;            rows: df1[&quot;currentTrial&quot;].eq(1)&amp;#10;        });&amp;#10;        df1_orig.resetIndex({ inplace: true });&amp;#10;&amp;#10;        // We will now compute the scores&amp;#10;        let df1_target = df1.loc({&amp;#10;            rows: df1[&quot;currentTrial&quot;].gt(1).and(df1[&quot;Target_Distractor&quot;].eq(&quot;Target&quot;))&amp;#10;        });&amp;#10;        df1_target.resetIndex({ inplace: true });&amp;#10;        &amp;#10;        // Select rows where decision_jar is not empty so that it won't perturn following means&amp;#10;        let df1_target_valid = df1_target.loc({&amp;#10;            rows: df1_target[&quot;Decision_jar&quot;].ne(&quot;&quot;)&amp;#10;        });&amp;#10;        df1_target_valid.resetIndex({ inplace: true });&amp;#10;        &amp;#10;        // Compute means only when it is possible and we don't have empty values&amp;#10;        df1[&quot;beads_orig_dtd&quot;] = df1_orig[&quot;DTD&quot;].values[0];&amp;#10;        df1[&quot;beads_orig_match&quot;] = df1_orig[&quot;Match&quot;].values[0];&amp;#10;        df1[&quot;beads_orig_trial_duration&quot;] = df1_orig[&quot;rating.rt&quot;].values[0];&amp;#10;        df1[&quot;beads_orig_confidence_rating&quot;] = df1_orig[&quot;rating.response&quot;].values[0];&amp;#10;        df1[&quot;beads_targ_dtd&quot;] = (df1_target[&quot;DTD&quot;]==null || df1_target[&quot;DTD&quot;].$data.length == 0) ? &quot;&quot; : df1_target[&quot;DTD&quot;].mean();&amp;#10;        df1[&quot;beads_targ_match&quot;] = (df1_target[&quot;Match&quot;]==null || df1_target[&quot;Match&quot;].$data.length == 0) ? &quot;&quot; : df1_target[&quot;Match&quot;].mean();&amp;#10;        df1[&quot;beads_targ_trial_duration&quot;] = (df1_target_valid[&quot;rating.rt&quot;]==null || df1_target_valid[&quot;rating.rt&quot;].$data.length == 0) ? &quot;&quot; : df1_target_valid[&quot;rating.rt&quot;].mean();&amp;#10;        df1[&quot;beads_targ_confidence_rating&quot;] = (df1_target_valid[&quot;rating.response&quot;]==null || df1_target_valid[&quot;rating.response&quot;].$data.length == 0) ? &quot;&quot; : df1_target_valid[&quot;rating.response&quot;].mean();&amp;#10;        &amp;#10;        //df1.print();&amp;#10;        //console.log(&quot;df1 orig: &quot;, df1_orig);&amp;#10;        //console.log(&quot;df1 target: &quot;, df1_target);&amp;#10;        //console.log(&quot;df1_target_valid: &quot;, df1_target_valid);&amp;#10;        //console.log(&quot;dataframe: &quot;, df1);&amp;#10;        &amp;#10;        let taskVersion = &quot;Online_v3.0.2&quot;; // Version of the task&amp;#10;        &amp;#10;        const exp_name = &quot;BEADS&quot;;&amp;#10;        &amp;#10;        df1[&quot;date_exp&quot;] = startingDate;&amp;#10;        df1[&quot;task_version&quot;] = taskVersion;&amp;#10;        &amp;#10;        // Save dataframe inside the logfile&amp;#10;        psychoJS.experiment.addData('date_exp', df1[&quot;date_exp&quot;]);&amp;#10;        psychoJS.experiment.addData('task_version', df1[&quot;task_version&quot;]);&amp;#10;        psychoJS.experiment.addData('beads_orig_dtd', df1[&quot;beads_orig_dtd&quot;]);&amp;#10;        psychoJS.experiment.addData('beads_orig_match', df1[&quot;beads_orig_match&quot;]);&amp;#10;        psychoJS.experiment.addData('beads_orig_trial_duration', df1[&quot;beads_orig_trial_duration&quot;]);&amp;#10;        psychoJS.experiment.addData('beads_orig_confidence_rating', df1[&quot;beads_orig_confidence_rating&quot;]);&amp;#10;        psychoJS.experiment.addData('beads_targ_dtd', df1[&quot;beads_targ_dtd&quot;]);&amp;#10;        psychoJS.experiment.addData('beads_targ_match', df1[&quot;beads_targ_match&quot;]);&amp;#10;        psychoJS.experiment.addData('beads_targ_trial_duration', df1[&quot;beads_targ_trial_duration&quot;]);&amp;#10;        psychoJS.experiment.addData('beads_targ_confidence_rating', df1[&quot;beads_targ_confidence_rating&quot;]);&amp;#10;        return df1;&amp;#10;    }&amp;#10;    catch(err) {&amp;#10;      console.log(&quot;Error while computing the scores.&quot;);&amp;#10;      dumpError(err);&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;function REDCapImportRecord(df1) {&amp;#10;    try{&amp;#10;      const url = 'https://portal.rimuhc.ca/cim/redcap/api/';&amp;#10;      let testdata;&amp;#10;      // Warning: If we add or remove columns in the Google file, we must also change the variables here&amp;#10;      testdata = [{&amp;#10;                record_id: df1.loc({rows: [0], columns: [&quot;participant&quot;]}).values[0][0],&amp;#10;                [redcapVars[1]]: df1.loc({rows: [0], columns: [&quot;session&quot;]}).values[0][0],&amp;#10;                [redcapVars[2]]: df1[&quot;date_exp&quot;],&amp;#10;                [redcapVars[3]]: df1[&quot;task_version&quot;],&amp;#10;                [redcapVars[4]]: df1[&quot;beads_orig_dtd&quot;],&amp;#10;                [redcapVars[5]]: df1[&quot;beads_orig_match&quot;],&amp;#10;                [redcapVars[6]]: df1[&quot;beads_orig_trial_duration&quot;],&amp;#10;                [redcapVars[7]]: df1[&quot;beads_orig_confidence_rating&quot;],&amp;#10;                [redcapVars[8]]: df1[&quot;beads_targ_dtd&quot;],&amp;#10;                [redcapVars[9]]: df1[&quot;beads_targ_match&quot;],&amp;#10;                [redcapVars[10]]: df1[&quot;beads_targ_trial_duration&quot;],&amp;#10;                [redcapVars[11]]: df1[&quot;beads_targ_confidence_rating&quot;]&amp;#10;      }];&amp;#10;      &amp;#10;      testdata = JSON.stringify(testdata);&amp;#10;      //console.log(&quot;testdata: &quot;, testdata);&amp;#10;&amp;#10;      const body = new FormData();&amp;#10;      body.append('token', redcapVars[0]);&amp;#10;      body.append('content', 'record');&amp;#10;      body.append('format', 'json');&amp;#10;      body.append('overwriteBehavior', 'normal');&amp;#10;      body.append('data', testdata);&amp;#10;      body.append('returnContent', 'ids');&amp;#10;&amp;#10;      const params = {&amp;#10;        method: 'POST',&amp;#10;        body,&amp;#10;      }&amp;#10;&amp;#10;    return fetch(url, params)&amp;#10;      .then(data =&gt; {&amp;#10;        console.log('fetch data: ', data)&amp;#10;      })&amp;#10;      .catch(error =&gt; console.log('Error: ', error))&amp;#10; &amp;#10;    }&amp;#10;    catch(err) {&amp;#10;        console.log(&quot;Error while sending data to redcap: &quot;);&amp;#10;        dumpError(err);&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;function dumpError(err) {&amp;#10;  if (typeof err === 'object') {&amp;#10;    if (err.message) {&amp;#10;      console.log('\nMessage: ' + err.message);&amp;#10;    }&amp;#10;    if (err.stack) {&amp;#10;      console.log('\nStacktrace:');&amp;#10;      console.log('====================');&amp;#10;      console.log(err.stack);&amp;#10;    }&amp;#10;  } else {&amp;#10;    console.log('dumpError :: argument is not an object');&amp;#10;  }&amp;#10;}&amp;#10;&amp;#10;//Call functions&amp;#10;SetTxtThx();&amp;#10;var res = GetData();&amp;#10;REDCapImportRecord(res);" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="import traceback&amp;#10;&amp;#10;#Change the text according to the selected language, function SetTxtInstr2()&amp;#10;if english:&amp;#10;    thx.text = &quot;Thank you for your participation!&quot;&amp;#10;else:&amp;#10;    thx.text = &quot;Merci de votre participation!&quot;&amp;#10;&amp;#10;#Get Data&amp;#10;try:&amp;#10;    df1 = pd.DataFrame.from_dict(thisExp.getAllEntries())&amp;#10;&amp;#10;    # Create all the variables we will need&amp;#10;    df1 = df1.assign(beads_orig_dtd=&quot;&quot;, beads_orig_match=&quot;&quot;, &amp;#10;    beads_orig_trial_duration=&quot;&quot;, beads_orig_confidence_rating=&quot;&quot;, &amp;#10;    beads_targ_dtd=&quot;&quot;, beads_targ_match=&quot;&quot;, &amp;#10;    beads_targ_trial_duration=&quot;&quot;, beads_targ_confidence_rating=&quot;&quot;)&amp;#10;    &amp;#10;    #Select first trial that is a testing one&amp;#10;    df1_orig = df1.query('currentTrial == 1')&amp;#10;    df1_orig.reset_index(drop=True, inplace=True) #indexing was a concern in some calculations.&amp;#10;    &amp;#10;    #We will now compute the scores&amp;#10;    df1[&quot;beads_orig_dtd&quot;] = df1_orig[&quot;DTD&quot;]&amp;#10;    df1[&quot;beads_orig_match&quot;] = df1_orig[&quot;Match&quot;]&amp;#10;    df1[&quot;beads_orig_trial_duration&quot;] = df1_orig['rating.rt']&amp;#10;    df1[&quot;beads_orig_confidence_rating&quot;] = df1_orig[&quot;rating.response&quot;]&amp;#10;&amp;#10;    #Select target trials&amp;#10;    df1_target = df1.query('currentTrial &gt; 1 and Target_Distractor == &quot;Target&quot;')&amp;#10;    df1_target.reset_index(drop=True, inplace=True)&amp;#10;    &amp;#10;    df1[&quot;beads_targ_dtd&quot;] = df1_target['DTD'].mean()&amp;#10;    df1[&quot;beads_targ_match&quot;] = df1_target['Match'].mean()&amp;#10;    &amp;#10;    #Remove rows where decision_jar is empty so that it won't perturn following means&amp;#10;    clean_df1_target = df1_target[df1_target.Decision_jar != &quot;&quot;]&amp;#10;    clean_df1_target.reset_index(drop=True, inplace=True)&amp;#10;    &amp;#10;    df1[&quot;beads_targ_trial_duration&quot;] = clean_df1_target['rating.rt'].mean()&amp;#10;    df1[&quot;beads_targ_confidence_rating&quot;] = clean_df1_target['rating.response'].mean()&amp;#10;&amp;#10;    # Remove nan values if we have any (e.g., no orig confidence rating)&amp;#10;    df1 = df1.fillna('')&amp;#10;&amp;#10;    # Save task version and date&amp;#10;    taskVersion = &quot;Offline_v3.0.2&quot;&amp;#10;    df1[&quot;date_exp&quot;] = startingDate&amp;#10;    df1[&quot;task_version&quot;] = taskVersion&amp;#10;    &amp;#10;    #print(&quot;df1&quot;, df1.to_string().encode('utf-8'))&amp;#10;    #print(&quot;columns &quot;, df1.columns)&amp;#10;    #print(&quot;df1 size: &quot;, df1.size)&amp;#10;&amp;#10;    thisExp.addData('date_exp', df1[&quot;date_exp&quot;].iloc[0])&amp;#10;    thisExp.addData('task_version', df1[&quot;task_version&quot;].iloc[0])&amp;#10;    thisExp.addData('beads_orig_dtd', df1[&quot;beads_orig_dtd&quot;].iloc[0])&amp;#10;    thisExp.addData('beads_orig_match', df1[&quot;beads_orig_match&quot;].iloc[0])&amp;#10;    thisExp.addData('beads_orig_trial_duration', df1[&quot;beads_orig_trial_duration&quot;].iloc[0])&amp;#10;    thisExp.addData('beads_orig_confidence_rating', df1[&quot;beads_orig_confidence_rating&quot;].iloc[0])&amp;#10;    thisExp.addData('beads_targ_dtd', df1[&quot;beads_targ_dtd&quot;].iloc[0])&amp;#10;    thisExp.addData('beads_targ_match', df1[&quot;beads_targ_match&quot;].iloc[0])&amp;#10;    thisExp.addData('beads_targ_trial_duration', df1[&quot;beads_targ_trial_duration&quot;].iloc[0])&amp;#10;    thisExp.addData('beads_targ_confidence_rating', df1[&quot;beads_targ_confidence_rating&quot;].iloc[0])&amp;#10;except Exception:&amp;#10;    print(&quot;An exception occurred. Error while computing scores.&quot;)&amp;#10;    traceback.print_exc()&amp;#10;    &amp;#10;# Send data to redcap&amp;#10;try:&amp;#10;    import requests, hashlib&amp;#10;    # Transform data to JSON Format&amp;#10;    # If we add or remove columns in the Google file, we must also change the variables here&amp;#10;    myDict = {}&amp;#10;    myDict[&quot;record_id&quot;] = df1['participant'].iloc[0]&amp;#10;    myDict[redcapVars[1]] = df1['session'].iloc[0]&amp;#10;    myDict[redcapVars[2]] = df1['date_exp'].iloc[0]&amp;#10;    myDict[redcapVars[3]] = df1['task_version'].iloc[0]&amp;#10;    myDict[redcapVars[4]] = df1['beads_orig_dtd'].iloc[0]&amp;#10;    myDict[redcapVars[5]] = df1['beads_orig_match'].iloc[0]&amp;#10;    myDict[redcapVars[6]] = df1['beads_orig_trial_duration'].iloc[0]&amp;#10;    myDict[redcapVars[7]] = df1['beads_orig_confidence_rating'].iloc[0]&amp;#10;    myDict[redcapVars[8]] = df1['beads_targ_dtd'].iloc[0]&amp;#10;    myDict[redcapVars[9]] = df1['beads_targ_match'].iloc[0]&amp;#10;    myDict[redcapVars[10]] = df1['beads_targ_trial_duration'].iloc[0]&amp;#10;    myDict[redcapVars[11]] = df1['beads_targ_confidence_rating'].iloc[0]&amp;#10;    &amp;#10;    data_to_send = [myDict]&amp;#10;    &amp;#10;    #print(&quot;data to send: &quot;, data_to_send)&amp;#10;    &amp;#10;    url = 'https://portal.rimuhc.ca/cim/redcap/api/'&amp;#10;    redcap_data = {&amp;#10;        'token': redcapVars[0],&amp;#10;        'content': 'record',&amp;#10;        'format': 'json',&amp;#10;        'type': 'flat',&amp;#10;        'overwriteBehavior': 'normal',&amp;#10;        'forceAutoNumber': 'false',&amp;#10;        'data': json.dumps(data_to_send),&amp;#10;        'returnContent': 'ids',&amp;#10;        'returnFormat': 'json',&amp;#10;        'record_id': hashlib.sha1().hexdigest()[:16]&amp;#10;    }&amp;#10;    x = requests.post(url, data = redcap_data)&amp;#10;    print(x.text)&amp;#10;    print(&quot;Data sent to redcap.&quot;)&amp;#10;except Exception:&amp;#10;    print(&quot;An exception occurred. Error while sending data to redcap.&quot;)&amp;#10;    traceback.print_exc()" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_thx" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="thx" plugin="None">
        <Param val="white" valType="str" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="" valType="str" updates="constant" name="flip"/>
        <Param val="Arial" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="0.1" valType="code" updates="constant" name="letterHeight"/>
        <Param val="thx" valType="code" updates="None" name="name"/>
        <Param val="1" valType="code" updates="constant" name="opacity"/>
        <Param val="0" valType="code" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="False" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="2" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Thank you for participating!" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="code" updates="constant" name="wrapWidth"/>
      </TextComponent>
    </Routine>
    <Routine name="trial">
      <RoutineSettingsComponent name="trial" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="trial" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="col = 'black'&amp;#10;currentTrial = 1" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="preventClick = function (event) { event.preventDefault(); }&amp;#10;document.addEventListener(&quot;contextmenu&quot;, preventClick, event, false);&amp;#10;col = new util.Color('black');&amp;#10;currentTrial = 1;&amp;#10;score = 0;&amp;#10;&amp;#10;//Decision jar that will be equal to the jar chosen by the participant&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="//declare variables&amp;#10;mouse_clicked = false;&amp;#10;select_decide = false;&amp;#10;jarpic = jarPicture;&amp;#10;ratingClick = 0;&amp;#10;ratingstart = true;&amp;#10;ratingstart1 = false;&amp;#10;ratingdone = false;&amp;#10;beadnum = 0;&amp;#10;beads = [bead1, bead2, bead3, bead4, bead5, bead6, bead7, bead8, bead9, bead10];&amp;#10;beadcolours = [];&amp;#10;true_jar = &quot;jarA&quot;;&amp;#10;rating_is_initialized = false;&amp;#10;confidenceRatings = [];&amp;#10;decision_jar = &quot;&quot;;&amp;#10;&amp;#10;//Jars texts&amp;#10;colorA_1 = txt_1;&amp;#10;colorA_2 = txt_2;&amp;#10;colorB_1 = txt_3;&amp;#10;colorB_2 = txt_4;&amp;#10;&amp;#10;//define slider marker and colour&amp;#10;rating = new visual.Slider({&quot;win&quot;: win, &quot;name&quot;: &quot;rating&quot;, &quot;size&quot;: [1.0, 0.05], &quot;pos&quot;: [0, (- 0.35)], &quot;labels&quot;: [&quot;0&quot;, &quot;100&quot;], &quot;ticks&quot;: [0, 100], &quot;granularity&quot;: 0, &quot;style&quot;: [&quot;rating&quot;], &quot;color&quot;: [0.65, 0.65, 0.65], &quot;markerColor&quot;: [-1, -1, -1], &quot;font&quot;: &quot;Arial&quot;, &quot;flip&quot;: false, &quot;labelHeight&quot;: 0.1});&amp;#10;rating.size[1] = rating.size[1] / 2;&amp;#10;markerSize = util.to_px(rating.size, 'height', psychoJS.window)[1];&amp;#10;&amp;#10;//randomize beads and colours&amp;#10;if ((Math.random() &gt; 0.5)) {&amp;#10;    true_jar = &quot;jarB&quot;;&amp;#10;    [A_R, A_G, A_B, B_R, B_G, B_B] = [B_R, B_G, B_B, A_R, A_G, A_B];&amp;#10;}&amp;#10;for (var i = 0, _pj_a = beads.length; (i &lt; _pj_a); i += 1) {&amp;#10;    if ((colorSequence[i] === &quot;A&quot;)) {&amp;#10;        beadcolours.append([A_R,A_G,A_B]);&amp;#10;    } else {&amp;#10;        if ((colorSequence[i] === &quot;B&quot;)) {&amp;#10;            beadcolours.append([B_R,B_G,B_B]);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;finalColor = [A_R,A_G,A_B]&amp;#10;jiggleColors = [&amp;#10;  [A_R,A_G,A_B],&amp;#10;  [B_R,B_G,B_B],&amp;#10;];&amp;#10;&amp;#10;jiggleActive = false;&amp;#10;jiggleIndex = 0;&amp;#10;jiggleFrames = 0;&amp;#10;jiggleDuration = 90;  // 2 seconds at 60 FPS&amp;#10;&amp;#10;//Change the text according to the selected language&amp;#10;function SetTxtTrial(){&amp;#10;    if (english){&amp;#10;        ratingtext.text = &quot;From which jar were the beads drawn?&quot;;&amp;#10;        jarAtext.text = &quot;JAR A&quot;;&amp;#10;        jarBtext.text = &quot;JAR B&quot;;&amp;#10;        scaletext.text = &quot;Please indicate your degree of confidence:&quot;;&amp;#10;        text_draw.text = &quot;DRAW ANOTHER BEAD&quot;;&amp;#10;        text_decide.text = &quot;MAKE A DECISION&quot;;&amp;#10;    }&amp;#10;    else{&amp;#10;        ratingtext.text = &quot;De quel pot viennent les billes?&quot;;&amp;#10;        jarAtext.text = &quot;POT A&quot;;&amp;#10;        jarBtext.text = &quot;POT B&quot;;&amp;#10;        scaletext.text = &quot;S’il vous plaît, veuillez évaluer votre degré de confiance :&quot;;&amp;#10;        text_draw.text = &quot;PIGER UNE AUTRE BILLE&quot;;&amp;#10;        text_decide.text = &quot;FAIRE VOTRE CHOIX&quot;;&amp;#10;    }&amp;#10;}&amp;#10;SetTxtTrial();" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="import random&amp;#10;&amp;#10;#declare variables&amp;#10;mouse_clicked = False&amp;#10;select_decide = False&amp;#10;jarpic = jarPicture&amp;#10;ratingClick = 0&amp;#10;ratingstart = False&amp;#10;ratingdone = False&amp;#10;beadnum = 1&amp;#10;beads = [bead1, bead2, bead3, bead4, bead5, bead6, bead7, bead8, bead9, bead10]&amp;#10;beadcolours = []&amp;#10;true_jar = &quot;jarA&quot;&amp;#10;rating_is_initialized = False&amp;#10;decision_jar = &quot;&quot;&amp;#10;&amp;#10;#Jars texts&amp;#10;colorA_1 = txt_1&amp;#10;colorA_2 = txt_2&amp;#10;colorB_1 = txt_3&amp;#10;colorB_2 = txt_4&amp;#10;&amp;#10;beadstxtA.text = colorA_1 +'\n'+colorA_2&amp;#10;beadstxtB.text = colorB_1 +'\n'+colorB_2&amp;#10;&amp;#10;#define slider marker and colour&amp;#10;rating = visual.Slider(win=win, name='rating', size=(1.0, 0.05), pos=(0, -0.35), labels=(&quot;0%&quot;, &quot;100%&quot;), ticks=(0, 100), granularity=0, style=(&quot;rating&quot;), color=(0.65, 0.65, 0.65), font='Arial', flip = False, labelHeight= 0.05)&amp;#10;#rating.size[1] = rating.size[1] / 2;&amp;#10;&amp;#10;#randomize beads and colours&amp;#10;if random.random() &gt; 0.5:&amp;#10;    true_jar = &quot;jarB&quot;&amp;#10;    [A_R, A_G, A_B, B_R, B_G, B_B] = [B_R, B_G, B_B, A_R, A_G, A_B]&amp;#10;    &amp;#10;for i in range(0, len(beads)):&amp;#10;    if colorSequence[i] == &quot;A&quot;:&amp;#10;        beadcolours.append([A_R,A_G,A_B])&amp;#10;    elif colorSequence[i] == &quot;B&quot;:&amp;#10;        beadcolours.append([B_R,B_G,B_B])&amp;#10;    i += 1&amp;#10;&amp;#10;#Change the text according to the selected language&amp;#10;if english:&amp;#10;    ratingtext.text = &quot;From which jar were the beads drawn?&quot;&amp;#10;    jarAtext.text = &quot;JAR A&quot;&amp;#10;    jarBtext.text = &quot;JAR B&quot;&amp;#10;    scaletext.text = &quot;Please indicate your degree of confidence:&quot;&amp;#10;    text_draw.text = &quot;DRAW ANOTHER BEAD&quot;&amp;#10;    text_decide.text = &quot;MAKE A DECISION&quot;&amp;#10;else:&amp;#10;    ratingtext.text = &quot;De quel pot viennent les billes?&quot;&amp;#10;    jarAtext.text = &quot;POT A&quot;&amp;#10;    jarBtext.text = &quot;POT B&quot;&amp;#10;    scaletext.text = &quot;S’il vous plaît, veuillez évaluer votre degré de confiance :&quot;&amp;#10;    text_draw.text = &quot;PIGER UNE AUTRE BILLE&quot;&amp;#10;    text_decide.text = &quot;FAIRE VOTRE CHOIX&quot;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="#first bead appears right away&amp;#10;bead1.setColor(beadcolours[1])&amp;#10;&amp;#10;#modify slider marker and colour&amp;#10;if rating_is_initialized == False:&amp;#10;    try:&amp;#10;        rating.marker.setColor(col, colorSpace='rgb')&amp;#10;        rating._barSize = (1, 0.01)&amp;#10;        rating._onChange(True)()&amp;#10;        rating._setupSlider()&amp;#10;    except:&amp;#10;        print(&quot;An exception while modifying slider&quot;)&amp;#10;    rating_is_initialized = True&amp;#10;&amp;#10;#display rating value&amp;#10;if rating.markerPos != 0 and rating.markerPos != None:&amp;#10;    rating_value.text = str(int(round(rating.markerPos)))&amp;#10;&amp;#10;#show jar selection&amp;#10;if select_decide == True and ratingdone == False and (mouse.getPressed()[0] == True and jarA.contains(mouse)):&amp;#10;    decision_jar = &quot;jarA&quot;&amp;#10;    ratingstart = True&amp;#10;&amp;#10;if select_decide == True and ratingdone == False and (mouse.getPressed()[0] == True and jarB.contains(mouse)):&amp;#10;    decision_jar = &quot;jarB&quot;&amp;#10;    ratingstart = True&amp;#10;    &amp;#10;#As soon as the rating of the confidence is done, the participants can no longer change the selected jar&amp;#10;if rating.getRating() != None:&amp;#10;    ratingdone = True&amp;#10;    &amp;#10;#move to next trial after rating + 1 second (allow for change in ratings within 1 second)&amp;#10;if rating.getRating() != None and routineTimer.getTime() &gt; rating.getRT() + 1 and rating.getRating() == rating.markerPos:&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;#Change the color of highlighed rect&amp;#10;if rect_draw.contains(mouse):&amp;#10;    rect_draw.opacity = 0.99&amp;#10;    text_draw.opacity = 2&amp;#10;else:&amp;#10;    rect_draw.opacity = 0.73&amp;#10;    text_draw.opacity = 0.73&amp;#10;if rect_decide.contains(mouse):&amp;#10;    rect_decide.opacity = 0.99&amp;#10;    text_decide.opacity = 2&amp;#10;else:&amp;#10;    rect_decide.opacity = 0.73&amp;#10;    text_decide.opacity = 0.73&amp;#10;&amp;#10;#Change the color of highlighed rect. We won't highligh if participant can not rate anymore &amp;#10;if ratingdone == False:&amp;#10;    if jarA.contains(mouse):&amp;#10;        jarA.opacity = 0.99&amp;#10;        jarAtext.opacity = 2&amp;#10;    else:&amp;#10;        jarA.opacity = 0.73&amp;#10;        jarAtext.opacity = 0.73&amp;#10;    if jarB.contains(mouse):&amp;#10;        jarB.opacity = 0.99&amp;#10;        jarBtext.opacity = 2&amp;#10;    else:&amp;#10;        jarB.opacity = 0.73&amp;#10;        jarBtext.opacity = 0.73&amp;#10;&amp;#10;if select_decide == False and rect_draw.contains(mouse) and mouse.getPressed()[0] == True:&amp;#10;    if mouse_clicked == False:&amp;#10;        mouse_clicked = True&amp;#10;        if beadnum == 10:&amp;#10;            beadnum = 11&amp;#10;            continueRoutine = False&amp;#10;        else:&amp;#10;            beads[beadnum].setColor(beadcolours[beadnum])&amp;#10;            beadnum += 1&amp;#10;else:&amp;#10;    mouse_clicked = False&amp;#10;&amp;#10;if rect_decide.contains(mouse) and mouse.getPressed()[0] == True:&amp;#10;    select_decide = Truebead" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="// first bead appears right away&amp;#10;if(beadnum == 0)&amp;#10;{&amp;#10;    beads[5].setFillColor(new util.Color(beadcolours[1]));&amp;#10;    beadnum += 1;&amp;#10;}&amp;#10;&amp;#10;// modify slider marker and colour&amp;#10;if (!rating_is_initialized &amp;&amp; rating.status === STARTED){&amp;#10;    try {&amp;#10;        rating._skin.STANDARD.MARKER_COLOR = col;&amp;#10;        rating._skin.MARKER_SIZE = [0.05, 0.05];&amp;#10;        rating._onChange(true)();&amp;#10;        //rating._setupSlider();&amp;#10;    }&amp;#10;    catch (err) {}&amp;#10;    rating_is_initialized  = true;&amp;#10;}&amp;#10;&amp;#10;// display rating value&amp;#10;if (rating.markerPos !== 0 &amp;&amp; rating.markerPos !== undefined) {&amp;#10;    rating_value.text = Math.round(rating.markerPos);&amp;#10;}&amp;#10;&amp;#10;// show jar selection&amp;#10;if (select_decide === true &amp;&amp; ratingdone === false &amp;&amp; (mouse.getPressed()[0] === 1 &amp;&amp; jarA.contains(mouse))) {&amp;#10;    decision_jar = &quot;jarA&quot;;&amp;#10;    ratingstart = true;&amp;#10;}&amp;#10;if (select_decide === true &amp;&amp; ratingdone === false &amp;&amp; (mouse.getPressed()[0] === 1 &amp;&amp; jarB.contains(mouse))) {&amp;#10;    decision_jar = &quot;jarB&quot;;&amp;#10;    ratingstart = true;&amp;#10;}&amp;#10;&amp;#10;// As soon as the rating of the confidence is done, the participants can no longer change the selected jar&amp;#10;if (rating.getRating() !== undefined){&amp;#10;    if(decision_jar !== &quot;&quot;)&amp;#10;    {&amp;#10;        ratingdone = true;&amp;#10;     }&amp;#10;//    else&amp;#10;//    {&amp;#10;//        ratingstart = false;&amp;#10;//        thisExp.addData(&quot;rating_draw&quot;, rating.getRating());&amp;#10;//        rating.reset();&amp;#10;//        ratingdone = true;     }&amp;#10;}&amp;#10;&amp;#10;if (ratingstart === true &amp;&amp; decision_jar === &quot;&quot; &amp;&amp; (rating.getRating() !== undefined) &amp;&amp; (trialClock.getTime() &gt; (rating.getRT() + 1)) &amp;&amp; rating.getRating() === rating.markerPos) {&amp;#10;    ratingstart = false;&amp;#10;//    thisExp.addData(&quot;rating_draw&quot;, rating.getRating());&amp;#10;    confidenceRatings.push(rating.getRating());&amp;#10;    rating.reset();&amp;#10;//    rating.setOpacity(0.0);&amp;#10;}&amp;#10;&amp;#10;// move to next trial after rating + 1 second (allow for change in ratings within 1 second)&amp;#10;if (decision_jar !== &quot;&quot; &amp;&amp; (rating.getRating() !== undefined) &amp;&amp; (trialClock.getTime() &gt; (rating.getRT() + 1)) &amp;&amp; rating.getRating() === rating.markerPos) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;&amp;#10;if (!ratingstart) {&amp;#10;//    HighlightRect(rect_draw, rect_decide, text_draw, text_decide, mouse);&amp;#10;    rating.reset();&amp;#10;    rating.markerPos = 0;&amp;#10;    rect_draw.setOpacity(1.0);&amp;#10;    text_draw.setOpacity(1.0);&amp;#10;    rect_decide.setOpacity(1.0);&amp;#10;    text_decide.setOpacity(1.0);&amp;#10;    rating.setOpacity(0.0);&amp;#10;    ratingtext.setOpacity(0.0);&amp;#10;    scaletext.setOpacity(0.0);&amp;#10;    rating_value.setOpacity(0.0);&amp;#10;    rating_value.text = &quot;0&quot;;&amp;#10;} else&amp;#10;{&amp;#10;    rect_draw.setOpacity(0.0);&amp;#10;    text_draw.setOpacity(0.0);&amp;#10;    rect_decide.setOpacity(0.0);&amp;#10;    text_decide.setOpacity(0.0);&amp;#10;//    rating.setOpacity(1.0);&amp;#10;    ratingtext.setOpacity(1.0);&amp;#10;    scaletext.setOpacity(1.0);&amp;#10;    rating_value.setOpacity(1.0);&amp;#10;&amp;#10;}&amp;#10;&amp;#10;//Change the color of highlighed rect&amp;#10;function HighlightRect(rec1, rec2, txt_rec1, txt_rec2, mouse) {&amp;#10;    if(rec1.opacity !== 0.0)&amp;#10;    {&amp;#10;         if (rec1.contains(mouse)) {&amp;#10;            rec1.setOpacity(0.99);&amp;#10;            txt_rec1.setOpacity(2);&amp;#10;         } &amp;#10;        else{&amp;#10;            rec1.setOpacity(0.73);&amp;#10;            txt_rec1.setOpacity(0.73);&amp;#10;        }&amp;#10;         if (rec2.contains(mouse)) {&amp;#10;            rec2.setOpacity(0.99);&amp;#10;            txt_rec2.setOpacity(2);&amp;#10;         } &amp;#10;        else{&amp;#10;            rec2.setOpacity(0.73);&amp;#10;            txt_rec2.setOpacity(0.73);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;//Change the color of highlighed rect. We won't highligh if participant can not rate anymore &amp;#10;function HighlightRect(rec1, rec2, txt_rec1, txt_rec2, mouse, ratingdone) {&amp;#10;    if (!ratingdone &amp;&amp; rec1.opacity !== 0){&amp;#10;         if (rec1.contains(mouse)) {&amp;#10;            rec1.setOpacity(0.99);&amp;#10;            txt_rec1.setOpacity(2);&amp;#10;         } &amp;#10;        else{&amp;#10;            rec1.setOpacity(0.73);&amp;#10;            txt_rec1.setOpacity(0.73);&amp;#10;        }&amp;#10;         if (rec2.contains(mouse)) {&amp;#10;            rec2.setOpacity(0.99);&amp;#10;            txt_rec2.setOpacity(2);&amp;#10;         } &amp;#10;        else{&amp;#10;            rec2.setOpacity(0.73);&amp;#10;            txt_rec2.setOpacity(0.73);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;if(select_decide === true)&amp;#10;{&amp;#10;    if(decision_jar === &quot;&quot;)&amp;#10;    {&amp;#10;            rating.setOpacity(0.0);&amp;#10;            ratingtext.setOpacity(0.0);&amp;#10;    }&amp;#10;    else&amp;#10;    {&amp;#10;            rating.setOpacity(1.0);&amp;#10;            ratingtext.setOpacity(1.0);&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;//Perform actions depending on clicked button (DRAW/DECIDE)&amp;#10;function SelectChoice(rec1, rec2, mouse){&amp;#10;    if (select_decide !== true &amp;&amp; rec1.contains(mouse) &amp;&amp; mouse.getPressed()[0] === 1 &amp;&amp; rec1.opacity !== 0) {&amp;#10;         if ((! mouse_clicked)) &amp;#10;         {&amp;#10;            mouse_clicked = true;&amp;#10;            if ((beadnum === 10))&amp;#10;            {&amp;#10;                beadnum = 11;&amp;#10;                continueRoutine = false;&amp;#10;            }&amp;#10;            else if((!jiggleActive) &amp;&amp; (beadnum &lt; beads.length))&amp;#10;            {&amp;#10;                jiggleActive = true;&amp;#10;                jiggleIndex = 0;&amp;#10;                jiggleFrames = 0;&amp;#10;                finalColor = beadcolours[beadnum];  // assumed to be [r, g, b]&amp;#10;//                beads[beadnum].setFillColor(finalColor, &quot;rgb&quot;);&amp;#10;//                beadnum += 1;&amp;#10;            }&amp;#10;         }&amp;#10;    }&amp;#10;    else {&amp;#10;            mouse_clicked = false;&amp;#10;    }&amp;#10;    &amp;#10;    if (rec2.contains(mouse) &amp;&amp; mouse.getPressed()[0] === 1 &amp;&amp; jiggleActive == false) {&amp;#10;       select_decide = true;&amp;#10;//       ratingstart = true;&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;if(select_decide === true)&amp;#10;{&amp;#10;   ratingtext.setOpacity(1.0);&amp;#10;}&amp;#10;&amp;#10;if (jiggleActive &amp;&amp; (beadnum &lt; beads.length))&amp;#10;{&amp;#10;     if (jiggleFrames &lt; jiggleDuration) {&amp;#10;        // Make the bead transparent&amp;#10;        beads[5].setOpacity(0.0);&amp;#10;        jiggleFrames += 1;&amp;#10;    } &amp;#10;    else {&amp;#10;        // Show final color with full opacity&amp;#10;        beads[5].setFillColor(finalColor, &quot;rgb&quot;);&amp;#10;        beads[5].setOpacity(1.0);&amp;#10;        jiggleActive = false;&amp;#10;        beadnum += 1;&amp;#10;        ratingstart = true;&amp;#10;        rating.setOpacity(1.0);&amp;#10;        scaletext.setOpacity(1.0);&amp;#10;//        rating.setOpacity(1.0);&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;Score.text = &quot;Beads Drawn: &quot; + beadnum;&amp;#10;HighlightRect(rect_draw, rect_decide, text_draw, text_decide, mouse);&amp;#10;HighlightRect(jarA, jarB, jarAtext, jarBtext, mouse, ratingdone);&amp;#10;SelectChoice(rect_draw, rect_decide, mouse);" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="document.removeEventListener(&quot;contextmenu&quot;, preventClick, event, false);" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if(rating.reponse){&amp;#10;    rating.response = parseFloat(rating.response);&amp;#10;}&amp;#10;&amp;#10;if(decision_jar == true_jar &amp;&amp; count != 1)&amp;#10;{&amp;#10;    score += 10-beadnum;&amp;#10;}&amp;#10;thisExp.addData(&quot;DTD&quot;, beadnum);&amp;#10;//thisExp.addData(&quot;Score&quot;, score);&amp;#10;thisExp.addData(&quot;Arand&quot;, [A_R,A_G,A_B]);&amp;#10;thisExp.addData(&quot;Brand&quot;, [B_R,B_G,B_B]);&amp;#10;thisExp.addData(&quot;Decision_jar&quot;, decision_jar);&amp;#10;thisExp.addData(&quot;True_jar&quot;, true_jar);&amp;#10;thisExp.addData('confidence_list', confidenceRatings.join(',')); // store as comma-separated string&amp;#10;thisExp.addData(&quot;Match&quot;, decision_jar===true_jar ? 1 : 0);&amp;#10;thisExp.addData('currentTrial', currentTrial);&amp;#10;currentTrial = currentTrial + 1;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData('DTD', beadnum)&amp;#10;thisExp.addData('Arand', [A_R,A_G,A_B])&amp;#10;thisExp.addData('Brand', [B_R,B_G,B_B])&amp;#10;thisExp.addData(&quot;Decision_jar&quot;, decision_jar)&amp;#10;thisExp.addData(&quot;True_jar&quot;, true_jar)&amp;#10;if decision_jar == true_jar:&amp;#10;    thisExp.addData(&quot;Match&quot;, 1)&amp;#10;else:&amp;#10;    thisExp.addData(&quot;Match&quot;, 0)&amp;#10;thisExp.addData('currentTrial', currentTrial)&amp;#10;currentTrial = currentTrial + 1" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <ImageComponent name="beadsimg1" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
